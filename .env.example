# Server Configuration
PORT=3000

# Telegram Bot Credentials
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram User ID
# Obtain via @userinfobot or @getmyid_bot in Telegram.
# Messages from any other Telegram user ID will be strictly dropped.
ALLOWED_TELEGRAM_USER_ID=123456789

# Google Gemini API
# Get an API Key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Optional: Model name (defaults to gemini-3.1-flash-lite; can also be gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Upstash Redis (REST Client)
# Create a free database at https://console.upstash.com/
# Copy the UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN from your database dashboard
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Secret Token for Webhook Cron Endpoints
# A secure random secret string to authenticate internal cron triggers via the "x-cron-secret" header
CRON_SECRET=super_secure_random_cron_token_change_me
